{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cuber Setup",
  "version": "0.1.0",
  "identifier": "net.cuber.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Установка Cuber",
        "width": 480,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../launcher/src-tauri/icons/32x32.png",
      "../../launcher/src-tauri/icons/128x128.png",
      "../../launcher/src-tauri/icons/icon.ico"
    ]
  }
}
